# MySQL (en Railway: ${{MySQL.MYSQL_URL}})
DATABASE_URL=mysql://user:password@localhost:3306/peptiva

# Admin: crea el primer administrador al arrancar si no hay ninguno
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Firma de sesiones (admin y afiliados), mínimo 32 caracteres aleatorios
SESSION_SECRET=

# Pagos Bankful
BANKFUL_API_USERNAME=
BANKFUL_API_PASSWORD=

# Emails (Resend)
RESEND_API_KEY=
MAIL_FROM=Peptiva Supplies <orders@peptivasupplies.com>
# Opcionales
SUPPORT_EMAIL=
ORDERS_NOTIFY_EMAIL=
# URL pública para enlaces en emails (en Railway se detecta sola con RAILWAY_PUBLIC_DOMAIN)
PUBLIC_URL=
